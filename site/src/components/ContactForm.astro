---
// Contact form. With a Web3Forms key (set by the deploy, or in a local .env as
// PUBLIC_WEB3FORMS_KEY) the message is delivered to your inbox; the key is
// public by design, it can only deliver messages to you. Without a key the
// form opens the visitor's email app with the message already written.
const key = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
interface Props { email: string }
const { email } = Astro.props;
---
<form class="contact-form" action="https://api.web3forms.com/submit" method="POST" data-contact data-key={key} data-email={email} novalidate>
  {key && <input type="hidden" name="access_key" value={key} />}
  <input type="hidden" name="from_name" value="Portfolio contact form" />
  <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="row-2">
    <div class="field">
      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required minlength="2" />
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required />
    </div>
  </div>
  <div class="field">
    <label for="cf-subject">Subject</label>
    <input id="cf-subject" name="subject" type="text" required minlength="3" />
  </div>
  <div class="field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" required minlength="10"></textarea>
  </div>
  <div class="actions">
    <button class="button" type="submit">Send message</button>
    <p class="status small" data-status role="status" aria-live="polite">
      {!key && 'Opens your email app with the message ready to send.'}
    </p>
  </div>
</form>

<style>
  .contact-form {
    display: grid; gap: 1rem; padding: clamp(1.25rem, 3vw, 2rem);
    background: color-mix(in srgb, var(--night-2) 85%, transparent); border: 1px solid var(--line); border-radius: 20px;
  }
  .row-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .status { margin: 0; color: var(--text-3); }
  .status.error { color: var(--error); }
  .status.ok { color: var(--amber-2); font-weight: 600; }
  input:user-invalid, textarea:user-invalid { border-color: var(--error); }
  @media (max-width: 560px) { .row-2 { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const hasKey = Boolean(form.dataset.key);
    const say = (text: string, kind: 'ok' | 'error' | '' = '') => {
      status.textContent = text;
      status.className = `status small ${kind}`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        say('Fill in every field: the message needs at least 10 characters.', 'error');
        return;
      }
      const data = new FormData(form);

      if (!hasKey) {
        const body = `${data.get('message')}\n\n${data.get('name')} (${data.get('email')})`;
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(String(data.get('subject')))}&body=${encodeURIComponent(body)}`;
        say('Your email app should open with the message ready. If it does not, write to the address on the left.');
        return;
      }

      button.disabled = true;
      say('Sending…');
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: data });
        const result = await res.json().catch(() => ({}));
        if (!res.ok || !result.success) throw new Error(result.message);
        form.reset();
        say('Message sent. I will reply by email.', 'ok');
      } catch {
        say('The message was not sent. Try again, or write to me by email.', 'error');
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
