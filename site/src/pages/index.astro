    font: inherit; font-size: 0.92rem; font-weight: 600; cursor: pointer; color: var(--text-2);
    background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 0.45rem 0.95rem;
  }
  .cred-filter button:hover { color: var(--text); border-color: var(--text-3); }
  .cred-filter button[aria-pressed='true'] { background: var(--amber); border-color: var(--amber); color: var(--night); }
  .cred-filter .num { opacity: 0.7; margin-left: 0.2rem; }
  .cred-wall { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(12.5rem, 100%), 1fr)); gap: 1rem; }
  .cred[hidden] { display: none; }
  .cred-link {
    display: grid; justify-items: center; text-align: center; gap: 0.5rem; height: 100%;
    padding: 1.4rem 1rem 1.2rem; border: 1px solid var(--line-2); border-radius: 18px; background: var(--night-2);
    color: var(--text); text-decoration: none; transition: border-color 160ms ease, transform 240ms var(--ease);
  }
  .cred-link:hover { border-color: var(--amber); transform: translateY(-3px); color: var(--text); }
  .cred-img { width: 96px; height: 96px; object-fit: contain; margin-bottom: 0.4rem; }
  .cred-img-text { display: grid; place-items: center; border-radius: 50%; border: 2px solid var(--line); font-weight: 700; font-size: 0.85rem; color: var(--amber-2); }
  .cred-name { font-weight: 620; font-size: 0.95rem; line-height: 1.3; }
