---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AskMe from '../components/AskMe.astro';
import Timeline from '../components/Timeline.astro';
import ContactForm from '../components/ContactForm.astro';
import ScrollChrome from '../components/ScrollChrome.astro';
import portrait from '../assets/portrait-office.jpg';
import { loadAll, loadAudioTranscript, loadBadgeRules, formatPeriod, formatMonth, monthIndex } from '../lib/content.mjs';
import { selectFeatured, groupByIssuer, isExpired } from '../lib/badges.mjs';
import { buildContext } from '../lib/askme.mjs';
import { withBase } from '../lib/paths.mjs';

const all = await loadAll();
const { profile, experience, engagements, publications, projects, recognition, skills, extra, credly } = all;

const rules = await loadBadgeRules();
const featured = await selectFeatured(credly.badges, rules);
const extras = extra.filter((c) => !isExpired(c)).map((c) => ({ ...c, local: true }));
const groups = groupByIssuer([...featured, ...extras], rules.issuerOrder);
const credentialCount = featured.length + extras.length;
const context = buildContext(all, { featured });
const transcript = await loadAudioTranscript();

const current = experience.filter((r) => !r.end);
const firstYear = experience.at(-1).start.slice(0, 4);
const years = new Date().getFullYear() - Number(firstYear);
const book = publications.find((p) => p.type === 'Book');
const others = publications.filter((p) => p !== book);
const credlyCount = credly.badges.length;

// Topics shown in the hero prompt; each one asks AskMe a real question.
const prompts = [
  { topic: 'my SAP Ariba work', question: 'What is your experience with SAP Ariba?', anchor: '#role-ariba-team-leader' },
  { topic: 'agentic AI for enterprises', question: 'How do you use Generative and Agentic AI with clients?', anchor: '#role-service-line-leader' },
  { topic: 'the book I wrote', question: 'Tell me about your SAP Press book.', anchor: '#publications' },
  { topic: 'my certifications', question: 'Which certifications do you hold?', anchor: '#credentials' },
];
const suggestions = [
  { question: 'What do you do as Service Line Leader?', anchor: '#role-service-line-leader' },
  ...prompts.map(({ question, anchor }) => ({ question, anchor })),
];

const latestRoleChange = Math.max(...experience.map((r) => monthIndex(r.start)));
if (profile.audio && monthIndex(profile.audio.recorded) < latestRoleChange) {
  console.warn(`[askme] The audio overview (recorded ${profile.audio.recorded}) is older than your latest role. Consider "npm run audio:script".`);
}

const today = new Date().toISOString().slice(0, 10);
const description = `${profile.name}: ${profile.role} at ${profile.organization}. ${profile.thesis}`;
---
<Base title={`${profile.name}, ${profile.role}`} description={description} updatedOn={today} credlySyncedOn={credly.syncedOn ?? today}>

  <!-- Hero -->
  <section class="hero" id="about" aria-labelledby="hero-name">
    <div class="hero-photo" aria-hidden="true">
      <Image src={portrait} alt="" widths={[640, 960, 1280]} sizes="(max-width: 820px) 100vw, 60vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap hero-inner">
      <p class="hero-role">{profile.role} at {profile.organization.split(',')[0]}, {profile.location.split(',')[0]}</p>
      <h1 class="hero-name" id="hero-name">
        <span>Vittorio</span>
        <span>Loris</span>
        <span>Simonetti</span>
      </h1>
      <p class="hero-thesis">{profile.thesis}</p>

      <button class="hero-ask" type="button" data-ask data-question={prompts[0].question} data-prompts={JSON.stringify(prompts)}>
        <span class="hero-ask-label">Ask me about</span>
        <span class="hero-ask-topic" data-topic aria-live="off">{prompts[0].topic}</span>
        <span class="hero-ask-go" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>

      <ul class="hero-proofs">
        {book && <li><a href="#publications">Author for {book.publisher}</a></li>}
        <li><a href="#publications">Inventor, patent filed in 2025</a></li>
        <li><a href="#credentials">{credlyCount} badges on Credly</a></li>
      </ul>
    </div>
  </section>

  <div class="wrap spine" data-spine>
  <div class="spine-track" aria-hidden="true"><div class="spine-fill"></div></div>

  <!-- Now -->
  <section class="section now" id="now" aria-labelledby="h-now">
    <div class="section-head">
      <h2 id="h-now" class="spine-node">What I do now</h2>
      <p class="section-lede">{current.length} roles at the same time, all at IBM Consulting.</p>
    </div>
    <ol class="now-list">
      {current.map((r) => (
        <li>
          <a class="now-item" href={`#role-${r.id}`}>
            <span class="now-since num">Since {formatMonth(r.start)}</span>
            <span class="now-title">{r.title}</span>
            <span class="now-summary">{r.highlights?.slice(0, 2).join('. ')}.</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- Experience -->
  <section class="section" id="experience" aria-labelledby="h-experience">
    <div class="section-head">
      <h2 id="h-experience" class="spine-node">{experience.length} roles in {years} years</h2>
      <p class="section-lede">From SAP developer to service line leader, with several roles running in parallel. Select a bar or a role to read what it involved.</p>
    </div>
    <Timeline roles={experience} />
    <div class="roles">
      {experience.map((r) => (
        <details class="role" id={`role-${r.id}`}>
          <summary>
            <span class="role-period num">{formatPeriod(r.start, r.end)}</span>
            <span class="role-title">{r.title}{!r.end && <span class="live">In progress</span>}</span>
            <span class="role-chev" aria-hidden="true"></span>
          </summary>
          <div class="role-body">
            {r.summary && <p class="measure">{r.summary}</p>}
            {r.highlights?.length > 0 && <ul>{r.highlights.map((h) => <li>{h}</li>)}</ul>}
          </div>
        </details>
      ))}
    </div>
    <div class="about measure">
      {profile.summary.slice(1).map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- Book and patent -->
  <section class="section" id="publications" aria-labelledby="h-publications">
    <div class="section-head">
      <h2 id="h-publications" class="spine-node">Author and inventor</h2>
    </div>
    {book && (
      <article class="book" id={`pub-${book.id}`}>
        <a class="book-cover" href={book.url} aria-label={`${book.title} on the ${book.publisher} website`}>
          <span class="book-publisher">{book.publisher}</span>
          <span class="book-title">{book.title}</span>
          <span class="book-author">Vittorio Loris Simonetti</span>
        </a>
        <div class="book-text">
          <p class="kicker">Book, {formatMonth(book.date)}</p>
          <h3><a href={book.url}>{book.title}</a></h3>
          <p class="muted">{book.summary}</p>
          <a class="button ghost" href={book.url}>See the book on the {book.publisher} website</a>
        </div>
      </article>
    )}
    <div class="ip">
      {others.map((p) => (
        <article class="ip-item" id={`pub-${p.id}`}>
          <p class="kicker">{p.type}, {formatMonth(p.date)}</p>
          <h3>{p.title}</h3>
          <p class="muted">{p.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Credentials -->
  <section class="section" id="credentials" aria-labelledby="h-credentials">
    <div class="section-head">
      <h2 id="h-credentials" class="spine-node">Credentials</h2>
      <p class="section-lede">
        {credentialCount} active certifications from SAP, The Open Group and others, plus IBM credentials on AI.
        The full record of {credlyCount} badges is on <a href={profile.links.credly}>Credly</a>.
      </p>
    </div>
    <div class="cred-filter" role="group" aria-label="Filter by issuer">
      <button type="button" data-filter="all" aria-pressed="true">All <span class="num">{credentialCount}</span></button>
      {groups.map((g) => <button type="button" data-filter={g.issuer} aria-pressed="false">{g.issuer} <span class="num">{g.items.length}</span></button>)}
    </div>
    <ul class="cred-wall">
      {groups.flatMap((g) => g.items.map((b) => (
        <li class="cred" data-issuer={g.issuer}>
          <a href={b.url ?? profile.links.credly} class="cred-link">
            {b.local
              ? <span class="cred-img cred-img-text" aria-hidden="true">{b.issuer.split(' ')[0]}</span>
              : <img class="cred-img" src={withBase(`badges/${b.id}.webp`)} alt="" width="96" height="96" loading="lazy" decoding="async" />}
            <span class="cred-name">{b.name}</span>
            <span class="cred-meta num">{b.issuer}, {formatMonth(b.issuedOn.slice(0, 7))}</span>
          </a>
        </li>
      )))}
    </ul>
  </section>

  <!-- Engagements -->
  <section class="section" id="engagements" aria-labelledby="h-engagements">
    <div class="section-head">
      <h2 id="h-engagements" class="spine-node">Where the work happened</h2>
      <p class="section-lede">Client engagements. Clients stay confidential, so they are described by industry.</p>
    </div>
    <ol class="eng-list">
      {engagements.map((e) => (
        <li class="eng">
          <span class="eng-industry">{e.industry}</span>
          <span class="eng-period num">{formatPeriod(e.start, e.end)}</span>
          <span class="eng-scope">{e.scope}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- More -->
  <section class="section more" id="more" aria-label="Skills, projects and recognition">
    <div class="more-col" id="skills">
      <h2 class="more-title spine-node">Skills</h2>
      <dl>
        {skills.map((g) => <div><dt>{g.group}</dt><dd>{g.items.join(', ')}</dd></div>)}
        <div><dt>Languages</dt><dd>{profile.languages.map((l) => `${l.name}, ${l.level}`).join('; ')}</dd></div>
        <div><dt>Education</dt><dd>{profile.education.map((e) => `${e.degree}, Federico II, ${e.end}`).join('; ')}</dd></div>
      </dl>
    </div>
    <div class="more-col" id="recognition">
      <h2 class="more-title">Recognition and teaching</h2>
      <ul>
        {[...recognition.awards.map((a) => ({ t: a.title, when: a.date, note: a.note })), ...recognition.teaching.map((a) => ({ t: a.title, when: a.period, note: a.note }))].map((a) => (
          <li><strong>{a.t}</strong> <span class="muted num">{a.when}</span><br /><span class="muted">{a.note}</span></li>
        ))}
      </ul>
    </div>
    <div class="more-col" id="projects">
      <h2 class="more-title">Side projects</h2>
      <ul>
        {projects.map((p) => <li><a href={p.url}><strong>{p.title}</strong></a><br /><span class="muted">{p.summary}</span><br /><span class="small muted">{p.stack.join(', ')}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- Contact -->
  <section class="section contact" id="contact" aria-labelledby="h-contact">
    <div class="contact-intro">
      <h2 id="h-contact" class="contact-title spine-node">Working on AI or SAP? Let's talk.</h2>
      <p class="section-lede">For projects, talks or anything AskMe could not answer. I reply by email.</p>
      <ul class="contact-links">
        <li><a href={`mailto:${profile.links.email}`}>{profile.links.email}</a></li>
        <li><a href={profile.links.linkedin}>LinkedIn</a></li>
        <li><a href={profile.links.credly}>Credly</a></li>
        <li><a href={profile.links.sapCommunity}>SAP Community</a></li>
        <li><a href={profile.links.github}>GitHub</a></li>
      </ul>
    </div>
    <ContactForm email={profile.links.email} />
  </section>
  </div>

  <ScrollChrome slot="overlay" />
  <AskMe slot="overlay" sources={context.sources} suggestions={suggestions} audio={profile.audio}
    audioRecordedLabel={profile.audio ? formatMonth(profile.audio.recorded) : undefined} transcript={transcript} />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; isolation: isolate; }
  .hero-photo { position: absolute; inset: 0 0 0 auto; width: min(52vw, 980px); z-index: -1; }
  .hero-photo :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 42% 30%;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 30%);
    mask-image: linear-gradient(to right, transparent 0%, #000 30%);
    filter: saturate(0.9) contrast(1.02);
  }
  .hero-photo::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, var(--night) 0%, transparent 40%), linear-gradient(to right, var(--night) 0%, transparent 30%);
  }
  .hero-inner { width: 100%; padding-top: 7rem; padding-bottom: clamp(3rem, 8vh, 5.5rem); }
  .hero-role { color: var(--amber-2); font-weight: 600; margin-bottom: 1.25rem; font-size: var(--step-0); }
  .hero-name {
    font-size: clamp(3.2rem, 7.4vw, 7.6rem); line-height: 0.9; font-weight: 820;
    font-variation-settings: 'wdth' 125; letter-spacing: -0.035em; margin-bottom: 1.75rem;
    display: grid; justify-items: start;
  }
  .hero-name span { display: block; }
  .hero-thesis { font-size: clamp(1.2rem, 2vw, 1.6rem); line-height: 1.38; max-width: 33rem; color: var(--text); margin-bottom: 2.25rem; }

  /* The one orchestrated moment: the name widens into place on load. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-name span { animation: widen 1.1s var(--ease) both; }
    .hero-name span:nth-child(2) { animation-delay: 90ms; }
    .hero-name span:nth-child(3) { animation-delay: 180ms; }
    .hero-role, .hero-thesis, .hero-ask, .hero-proofs { animation: rise 700ms var(--ease) 650ms both; }
    .hero-photo :global(img) { animation: settle 1.6s var(--ease) both; }
    @keyframes widen { from { font-variation-settings: 'wdth' 62; opacity: 0; } to { font-variation-settings: 'wdth' 125; opacity: 1; } }
    @keyframes rise { from { opacity: 0; transform: translateY(10px); } }
    @keyframes settle { from { opacity: 0; transform: scale(1.06); } }
  }

  .hero-ask {
    display: inline-flex; align-items: center; gap: 0.75rem; max-width: 100%;
    font: inherit; font-size: var(--step-1); color: var(--text); cursor: pointer; text-align: left;
    background: color-mix(in srgb, var(--night-2) 80%, transparent); backdrop-filter: blur(8px);
    border: 1px solid var(--line); border-radius: 999px; padding: 0.6rem 0.6rem 0.6rem 1.4rem;
    transition: border-color 160ms ease, background-color 160ms ease;
  }
  .hero-ask:hover { border-color: var(--amber); background: var(--night-3); }
  .hero-ask-label { color: var(--text-2); white-space: nowrap; }
  .hero-ask-topic { color: var(--amber-2); font-weight: 650; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: opacity 220ms ease; }
  .hero-ask-topic[data-swap] { opacity: 0; }
  .hero-ask-go { flex: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; display: grid; place-items: center; background: var(--amber); color: var(--night); }

  .hero-proofs { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; padding: 0; margin: 1.75rem 0 0; font-size: 0.95rem; }
  .hero-proofs li { display: flex; align-items: center; gap: 0.55rem; }
  .hero-proofs li::before { content: ''; width: 1rem; height: 2px; background: var(--amber); }
  .hero-proofs a { color: var(--text-2); text-decoration: none; }
  .hero-proofs a:hover { color: var(--text); text-decoration: underline; }

  @media (max-width: 820px) {
    .hero { display: block; min-height: 0; }
    .hero-photo { position: relative; inset: auto; width: 100%; height: 62svh; z-index: 0; }
    .hero-photo :global(img) { object-position: 45% 25%; mask-image: none; -webkit-mask-image: none; }
    .hero-photo::after { background: linear-gradient(to top, var(--night) 8%, rgba(10, 20, 34, 0.75) 32%, transparent 60%); }
    .hero-inner { position: relative; margin-top: -7rem; padding-top: 0; }
    .hero-ask { font-size: 1.05rem; padding-left: 1.1rem; }
  }

  /* ---------- Spine ----------
     One line along the left edge of the content, from "What I do now" to the
     contact. Every section heading sits on a node of the line; the line fills
     with amber as you read. */
  .spine { --spine-x: 0.5rem; --spine-pad: clamp(2.75rem, 5vw, 5rem); position: relative; padding-left: calc(var(--gutter) + var(--spine-pad)); }
  .spine-track {
    position: absolute; left: calc(var(--gutter) + var(--spine-x)); width: 2px; border-radius: 2px;
    top: calc(var(--section-gap) + 1.2rem); bottom: 0;
    background: linear-gradient(to bottom, var(--line), var(--line) 92%, transparent);
  }
  .spine-fill {
    position: absolute; inset: 0 0 auto 0; height: calc(var(--spine-fill, 0) * 100%); border-radius: 2px;
    background: linear-gradient(to bottom, rgba(242, 180, 90, 0.15), var(--amber));
    box-shadow: 0 0 12px rgba(242, 180, 90, 0.45);
  }
  .spine :global(.spine-node) { position: relative; }
  .spine :global(.spine-node)::before {
    content: ''; position: absolute; top: 0.55em; transform: translateY(-50%);
    left: calc(-1 * var(--spine-pad) + var(--spine-x) + 1px - 8px);
    width: 16px; height: 16px; border-radius: 50%; box-sizing: border-box;
    background: var(--night); border: 2px solid var(--line);
    transition: background-color 300ms ease, border-color 300ms ease, box-shadow 300ms ease;
  }
  .spine :global(.spine-node[data-reached])::before { background: var(--amber); border-color: var(--amber); }
  .spine :global(.spine-node[data-current])::before { box-shadow: 0 0 0 6px var(--amber-wash), 0 0 18px rgba(242, 180, 90, 0.6); }
  /* The headings are of different sizes: keep every node the same size. */
  .spine :global(.spine-node)::before { font-size: inherit; }
  @media (max-width: 760px) {
    .spine { --spine-x: 0.15rem; --spine-pad: 1.5rem; }
    .spine :global(.spine-node)::before { width: 12px; height: 12px; left: calc(-1 * var(--spine-pad) + var(--spine-x) + 1px - 6px); }
  }

  /* ---------- Now ---------- */
  .now-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .now-item {
    display: grid; grid-template-columns: 10rem minmax(0, 1.4fr) minmax(0, 1fr); gap: 1.5rem; align-items: baseline;
    padding: 1.6rem 0; border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none;
    transition: padding-left 240ms var(--ease);
  }
  .now-item:hover { padding-left: 0.75rem; color: var(--text); }
  .now-item:hover .now-title { color: var(--amber-2); }
  .now-since { color: var(--amber); font-size: var(--step--1); font-weight: 600; }
  .now-title { font-size: var(--step-2); font-weight: 720; font-variation-settings: 'wdth' 112; line-height: 1.15; transition: color 160ms ease; }
  .now-summary { color: var(--text-2); font-size: 0.97rem; }
  @media (max-width: 820px) { .now-item { grid-template-columns: minmax(0, 1fr); gap: 0.4rem; } }

  /* ---------- Experience ---------- */
  .roles { margin-top: 2.5rem; border-top: 1px solid var(--line); }
  .role { border-bottom: 1px solid var(--line); }
  .role summary {
    list-style: none; cursor: pointer; display: grid; grid-template-columns: 11rem minmax(0, 1fr) 1.25rem;
    gap: 1.5rem; align-items: baseline; padding: 1.1rem 0;
  }
  .role summary::-webkit-details-marker { display: none; }
  .role summary:hover .role-title { color: var(--amber-2); }
  .role-period { color: var(--text-3); font-size: var(--step--1); }
  .role-title { font-weight: 650; font-size: 1.1rem; transition: color 160ms ease; }
  .live { margin-left: 0.75rem; font-size: 0.78rem; font-weight: 700; color: var(--night); background: var(--amber); padding: 0.1rem 0.5rem; border-radius: 999px; vertical-align: 0.15em; }
  .role-chev { width: 0.6rem; height: 0.6rem; border-right: 2px solid var(--text-3); border-bottom: 2px solid var(--text-3); transform: rotate(45deg); transition: transform 200ms var(--ease); justify-self: end; }
  .role[open] .role-chev { transform: rotate(225deg); }
  .role-body { padding: 0 0 1.4rem 12.5rem; color: var(--text-2); }
  .role-body ul { margin: 0; padding-left: 1.1rem; }
  .role:target { background: linear-gradient(to right, var(--amber-wash), transparent 60%); }
  .about { margin-top: 3rem; color: var(--text-2); font-size: var(--step-1); line-height: 1.5; }
  @media (max-width: 760px) {
    .role summary { grid-template-columns: minmax(0, 1fr) 1rem; gap: 0.2rem 1rem; }
    .role-period { grid-row: 1; }
    .role-title { grid-row: 2; }
    .role-chev { grid-row: 1 / span 2; align-self: center; }
    .role-body { padding-left: 0; }
  }

  /* ---------- Book and patent ---------- */
  .kicker { color: var(--amber); font-weight: 600; font-size: var(--step--1); margin-bottom: 0.5rem; }
  .book {
    display: grid; grid-template-columns: minmax(14rem, 20rem) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem); background: var(--night-2); border: 1px solid var(--line); border-radius: 20px;
  }
  .book-cover {
    aspect-ratio: 7 / 9; display: flex; flex-direction: column; justify-content: space-between; padding: 1.5rem 1.4rem 1.4rem 2rem;
    background: linear-gradient(160deg, #1E3A66 0%, #13294A 60%, #0E1F38 100%); color: var(--text); text-decoration: none;
    border-radius: 4px 10px 10px 4px; position: relative;
    box-shadow: 0 30px 60px -25px rgba(0, 0, 0, 0.7), inset 6px 0 0 var(--amber);
    transform: perspective(900px) rotateY(-14deg); transition: transform 500ms var(--ease);
  }
  .book-cover:hover { transform: perspective(900px) rotateY(-4deg); color: var(--text); }
  .book-publisher { font-size: 0.8rem; font-weight: 700; color: var(--amber-2); }
  .book-title { font-size: 1.55rem; line-height: 1.12; font-weight: 780; font-variation-settings: 'wdth' 108; }
  .book-author { font-size: 0.85rem; color: var(--text-2); }
  .book-text h3 { font-size: var(--step-2); margin-bottom: 0.75rem; font-variation-settings: 'wdth' 112; }
  .book-text h3 a { color: var(--text); text-decoration: none; }
  .book-text h3 a:hover { color: var(--amber-2); }
  .book-text .button { margin-top: 0.5rem; }
  .ip { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 1.25rem; }
  .ip-item { padding: 1.75rem; border: 1px solid var(--line); border-radius: 20px; }
  .ip-item h3 { margin-bottom: 0.6rem; }
  .ip-item:target, .book:target { border-color: var(--amber); }
  @media (max-width: 820px) {
    .book { grid-template-columns: minmax(0, 1fr); }
    .book-cover { max-width: 15rem; transform: none; }
    .ip { grid-template-columns: minmax(0, 1fr); }
