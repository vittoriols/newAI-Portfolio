---
import { withBase } from '../lib/paths.mjs';

interface Suggestion { question: string; anchor: string }
interface Props {
  sources: Record<string, { title: string; anchor: string }>;
  suggestions: Suggestion[];
  audio?: { file: string; duration: string; recorded: string; madeWith?: string };
  audioRecordedLabel?: string;
  transcript?: { speaker: string; text: string }[] | null;
}
const { sources, suggestions, audio, audioRecordedLabel, transcript } = Astro.props;
const endpoint = import.meta.env.PUBLIC_ASKME_ENDPOINT ?? '';
---
<section class="askme" id="ask" aria-labelledby="ask-title" data-endpoint={endpoint} data-sources={JSON.stringify(sources)}>
  <div class="askme-bar">
    <h2 id="ask-title" class="askme-title">AskMe</h2>
    <span class="askme-status" data-status>{endpoint ? 'Online' : 'Not connected'}</span>
  </div>

  <div class="askme-body">
    <p class="askme-intro" data-intro>
      {endpoint
        ? 'Ask about my roles, certifications or publications. Every answer links to the part of this page it comes from.'
        : 'The assistant is not connected yet. The questions below take you to the part of the page that answers them.'}
    </p>

    <ul class="askme-suggestions" aria-label="Suggested questions">
      {suggestions.map((s) => (
        <li><a href={s.anchor} class="suggestion" data-question={s.question}>{s.question}</a></li>
      ))}
    </ul>

    <div class="askme-log" data-log aria-live="polite" hidden></div>

    <form class="askme-form" data-form hidden={!endpoint}>
      <label for="ask-input" class="visually-hidden">Your question</label>
      <input id="ask-input" name="q" type="text" maxlength="800" autocomplete="off" required
        placeholder="Type your question" />
      <button class="button" type="submit">Ask</button>
    </form>
  </div>

  {audio && (
    <div class="askme-audio">
      <p class="askme-audio-label">
        Listen to a {audio.duration} overview
        <span class="muted">Recorded {audioRecordedLabel}{audio.madeWith && `, made with ${audio.madeWith}`}</span>
      </p>
      <audio controls preload="none" src={withBase(audio.file)}>
        <a href={withBase(audio.file)}>Download the audio overview</a>
      </audio>
      {transcript && (
        <details class="askme-transcript">
          <summary>Read the transcript</summary>
          {transcript.map((t) => <p><strong>{t.speaker}:</strong> {t.text}</p>)}
        </details>
      )}
    </div>
  )}
</section>

<style>
  .askme { background: var(--sheet); border: 1px solid var(--ink); }
  .askme-bar {
    display: flex; align-items: center; justify-content: space-between;
    background: var(--ink); color: #fff; padding: 0.55rem 1rem;
  }
  .askme-title { font-size: 1rem; font-weight: 700; font-variation-settings: 'wdth' 110; letter-spacing: 0; }
  .askme-status { font-size: 0.82rem; display: inline-flex; align-items: center; gap: 0.45rem; color: #D6DCE3; }
  .askme-status::before { content: ''; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--off); }
  .askme[data-online] .askme-status::before { background: #3DBE86; }

  .askme-body { padding: 1.1rem 1.1rem 1.2rem; }
  .askme-intro { color: var(--ink-2); font-size: 0.97rem; margin-bottom: 0.9rem; }

  .askme-suggestions[hidden], .askme-intro[hidden] { display: none; }
  .askme-suggestions { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.4rem; }
  .suggestion {
    display: block; padding: 0.55rem 0.75rem; border: 1px solid var(--rule); border-radius: 2px;
    color: var(--ink); text-decoration: none; font-size: 0.95rem; background: var(--paper);
  }
  .suggestion:hover { border-color: var(--signal); color: var(--signal); background: var(--signal-wash); }

  .askme-log { display: grid; gap: 0.9rem; margin-bottom: 1rem; max-height: 26rem; overflow-y: auto; padding-right: 0.25rem; }
  .askme-log :global(.msg) { font-size: 0.97rem; line-height: 1.5; }
  .askme-log :global(.msg p) { margin: 0 0 0.6rem; }
  .askme-log :global(.msg p:last-child) { margin-bottom: 0; }
  .askme-log :global(.msg-user) {
    justify-self: end; max-width: 85%; background: var(--signal-wash); padding: 0.5rem 0.75rem; border-radius: 2px;
  }
  .askme-log :global(.msg-assistant) { border-left: 2px solid var(--signal); padding-left: 0.8rem; }
  .askme-log :global(.msg-error) { border-left-color: var(--off); color: var(--ink-2); }
  .askme-log :global(.msg-sources) { margin-top: 0.5rem; font-size: 0.85rem; color: var(--ink-2); }
  .askme-log :global(.msg-sources a) { margin-right: 0.6rem; }
  .askme-log :global(.typing) { color: var(--ink-3); }

  .askme-form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.5rem; }
  .askme-form[hidden] { display: none; }

  .askme-audio { border-top: 1px solid var(--rule); padding: 0.9rem 1.1rem 1.1rem; background: var(--paper); }
  .askme-audio-label { margin: 0 0 0.55rem; font-weight: 600; font-size: 0.95rem; }
  .askme-audio-label .muted { display: block; font-weight: 400; font-size: 0.85rem; }
  .askme-audio audio { width: 100%; height: 2.5rem; }
  .askme-transcript { margin-top: 0.75rem; font-size: 0.92rem; }
  .askme-transcript summary { cursor: pointer; color: var(--signal); font-weight: 600; }
  .askme-transcript[open] { max-height: 22rem; overflow-y: auto; }
  .askme-transcript p { margin: 0.6rem 0 0; }
</style>

<script>
  type Source = { title: string; anchor: string };
  type Msg = { role: 'user' | 'assistant'; content: string };

  const root = document.querySelector<HTMLElement>('.askme');
  const endpoint = root?.dataset.endpoint ?? '';

  if (root && endpoint) {
    const sources: Record<string, Source> = JSON.parse(root.dataset.sources ?? '{}');
    const log = root.querySelector<HTMLElement>('[data-log]')!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const input = form.querySelector<HTMLInputElement>('input')!;
    const button = form.querySelector<HTMLButtonElement>('button')!;
    const history: Msg[] = [];
    root.dataset.online = '';

    const escape = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
    const citations = /\[\[([a-z0-9-]+)\]\]/gi;

    function render(el: HTMLElement, text: string, done: boolean) {
      const cited = new Set<string>();
      const clean = text.replace(citations, (_, id) => { if (sources[id]) cited.add(id); return ''; })
        .replace(/\[\[[^\]]*$/, '');
      el.innerHTML = clean.trim().split(/\n{2,}/).map((p) => `<p>${escape(p.trim()).replace(/\n/g, '<br>')}</p>`).join('');
      if (done && cited.size) {
        const links = [...cited].map((id) => `<a href="${sources[id].anchor}">${escape(sources[id].title)}</a>`).join('');
        el.insertAdjacentHTML('beforeend', `<p class="msg-sources">Sources: ${links}</p>`);
      }
    }

    function bubble(role: 'user' | 'assistant') {
      const el = document.createElement('div');
      el.className = `msg msg-${role}`;
      log.hidden = false;
      log.append(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    const suggestionList = root.querySelector<HTMLElement>('.askme-suggestions');
    const intro = root.querySelector<HTMLElement>('[data-intro]');

    async function ask(question: string) {
      // Once the conversation starts, the suggestions make room for it.
      if (suggestionList) suggestionList.hidden = true;
      if (intro) intro.hidden = true;
      history.push({ role: 'user', content: question });
      bubble('user').textContent = question;
      const out = bubble('assistant');
      out.innerHTML = '<p class="typing">Thinking…</p>';
      button.disabled = true;
      input.disabled = true;

      let text = '';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history }),
        });
        if (res.status === 429) throw new Error('Too many questions in a short time. Try again in a minute.');
        if (!res.ok || !res.body) throw new Error('AskMe could not answer right now. Try again, or write to me with the contact form.');

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        for (;;) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split('\n');
          buffer = lines.pop() ?? '';
          for (const line of lines) {
            const data = line.replace(/^data:\s*/, '').trim();
            if (!data || data === '[DONE]' || !line.startsWith('data:')) continue;
            try { text += JSON.parse(data).choices?.[0]?.delta?.content ?? ''; } catch { /* partial line */ }
          }
          render(out, text, false);
          log.scrollTop = log.scrollHeight;
        }
        if (!text.trim()) throw new Error('AskMe returned an empty answer. Try rephrasing the question.');
        render(out, text, true);
        history.push({ role: 'assistant', content: text });
      } catch (err) {
        history.pop();
        out.classList.add('msg-error');
        out.textContent = err instanceof Error ? err.message : String(err);
      } finally {
        button.disabled = false;
        input.disabled = false;
        input.focus();
        log.scrollTop = log.scrollHeight;
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      input.value = '';
      ask(q);
    });

    root.querySelectorAll<HTMLAnchorElement>('.suggestion').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        ask(a.dataset.question ?? a.textContent ?? '');
      });
    });
  }
</script>
