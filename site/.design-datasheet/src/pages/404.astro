---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/paths.mjs';
---
<Base title="Page not found, Vittorio Loris Simonetti" description="This page does not exist." nav={false}>
  <div class="wrap notfound">
    <p class="code num">404</p>
    <h1>This page does not exist</h1>
    <p class="muted">The site now lives on a single page. Everything that was on the old pages is there.</p>
    <a class="button" href={withBase('')}>Go to the home page</a>
  </div>
</Base>

<style>
  .notfound { padding-block: 5rem 2rem; max-width: 40rem; margin-inline: 0; }
  .code { font-size: 5rem; font-weight: 300; font-variation-settings: 'wdth' 62; color: var(--signal); margin: 0; line-height: 1; }
  h1 { font-size: var(--step-3); font-variation-settings: 'wdth' 112; margin: 0.5rem 0 1rem; }
</style>
