---
import Base from '../layouts/Base.astro';
import AskMe from '../components/AskMe.astro';
import Timeline from '../components/Timeline.astro';
import ContactForm from '../components/ContactForm.astro';
import { loadAll, loadAudioTranscript, formatPeriod, formatMonth, monthIndex } from '../lib/content.mjs';
import { selectFeatured, groupByIssuer, isExpired } from '../lib/badges.mjs';
import { buildContext } from '../lib/askme.mjs';
import { loadBadgeRules } from '../lib/content.mjs';
import { withBase } from '../lib/paths.mjs';

const all = await loadAll();
const { profile, experience, engagements, publications, projects, recognition, skills, extra, credly } = all;

const rules = await loadBadgeRules();
const featured = await selectFeatured(credly.badges, rules);
const extras = extra.filter((c) => !isExpired(c)).map((c) => ({ ...c, local: true }));
const groups = groupByIssuer([...featured, ...extras], rules.issuerOrder);
const activeCount = featured.length + extras.length;
const context = buildContext(all, { featured });
const transcript = await loadAudioTranscript();

const current = experience.filter((r) => !r.end);
const book = publications.find((p) => p.type === 'Book');
const patent = publications.find((p) => p.type === 'Patent');

const suggestions = [
  { question: 'What do you do as Service Line Leader?', anchor: '#role-service-line-leader' },
  { question: 'What is your experience with SAP Ariba?', anchor: '#role-ariba-team-leader' },
  { question: 'Which certifications do you hold?', anchor: '#credentials' },
  { question: 'Tell me about your book and your patent.', anchor: '#publications' },
];

// Warn at build time when the audio predates the latest change of role.
const latestRoleChange = Math.max(...experience.map((r) => monthIndex(r.start)));
if (profile.audio && monthIndex(profile.audio.recorded) < latestRoleChange) {
  console.warn(`[askme] The audio overview (recorded ${profile.audio.recorded}) is older than your latest role. Consider "npm run audio:script".`);
}

const today = new Date().toISOString().slice(0, 10);
const credlySyncedOn = credly.syncedOn ?? today;
const description = `${profile.name}: ${profile.role} at ${profile.organization}. ${profile.thesis}`;
const credlyCount = credly.badges.length;
---
<Base title={`${profile.name}, ${profile.role}`} description={description} updatedOn={today} credlySyncedOn={credlySyncedOn}>

  <!-- Hero -->
  <div class="wrap hero" id="about">
    <div class="hero-intro">
      <h1 class="name">Vittorio<br />Loris<br />Simonetti</h1>
      <p class="hero-role">{profile.role} at {profile.organization}, {profile.location}</p>
      <p class="thesis">{profile.thesis}</p>
    </div>

    <div class="hero-specs">
      <table class="spec key-specs">
        <caption class="visually-hidden">Key facts</caption>
        <tbody>
          <tr><th scope="row">Now</th><td>{current.map((r) => r.title).join(', ')}</td></tr>
          {profile.background && <tr><th scope="row">Background</th><td>{profile.background}</td></tr>}
          {book && <tr><th scope="row">Author</th><td><a href={`#pub-${book.id}`}>{book.title}</a>, {book.publisher}, {formatMonth(book.date)}</td></tr>}
          {patent && <tr><th scope="row">Inventor</th><td><a href={`#pub-${patent.id}`}>Patent on Generative AI for accessibility</a>, filed {formatMonth(patent.date)}</td></tr>}
          <tr><th scope="row">Credentials</th><td><a href="#credentials">{activeCount} certifications in force</a>, out of {credlyCount} badges on Credly</td></tr>
        </tbody>
      </table>
    </div>

    <div class="hero-ask">
      <AskMe sources={context.sources} suggestions={suggestions} audio={profile.audio}
        audioRecordedLabel={profile.audio ? formatMonth(profile.audio.recorded) : undefined} transcript={transcript} />
    </div>
  </div>

  <div class="wrap">
    <!-- 1 Experience -->
    <section class="section" id="experience" aria-labelledby="h-experience">
      <div class="section-head">
        <span class="section-num">1</span>
        <h2 id="h-experience">Experience</h2>
        <p class="section-intro">{experience.length} roles at IBM since {experience.at(-1).start.slice(0, 4)}, several of them at the same time.</p>
      </div>
      <div class="section-body">
        <div class="about measure">
          {profile.summary.map((p) => <p>{p}</p>)}
        </div>
        <Timeline roles={experience} />
        <ol class="roles">
          {experience.map((r) => (
            <li class="role" id={`role-${r.id}`}>
              <p class="role-period num">{formatPeriod(r.start, r.end)}{!r.end && <span class="tag-live">In progress</span>}</p>
              <div>
                <h3>{r.title}</h3>
                <p class="role-company muted">{r.company}</p>
                {r.summary && <p class="measure">{r.summary}</p>}
                {r.highlights?.length > 0 && (
                  <ul class="role-highlights">{r.highlights.map((h) => <li>{h}</li>)}</ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 2 Engagements -->
    <section class="section" id="engagements" aria-labelledby="h-engagements">
      <div class="section-head">
        <span class="section-num">2</span>
        <h2 id="h-engagements">Client engagements</h2>
        <p class="section-intro">Clients stay confidential, so they are described by industry.</p>
      </div>
      <div class="section-body table-scroll">
        <table class="spec">
          <thead><tr><th scope="col">Industry</th><th scope="col">Period</th><th scope="col">Scope</th></tr></thead>
          <tbody>
            {engagements.map((e) => (
              <tr><th scope="row">{e.industry}</th><td class="num nowrap">{formatPeriod(e.start, e.end)}</td><td>{e.scope}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 3 Credentials -->
    <section class="section" id="credentials" aria-labelledby="h-credentials">
      <div class="section-head">
        <span class="section-num">3</span>
        <h2 id="h-credentials">Credentials</h2>
        <p class="section-intro">
          Active third-party certifications and IBM credentials on AI. The full record
          of {credlyCount} badges, courses included, is on <a href={profile.links.credly}>Credly</a>.
        </p>
      </div>
      <div class="section-body creds">
        {groups.map((g) => (
          <div class="cred-group">
            <h3 class="cred-issuer">{g.issuer} <span class="muted num">{g.items.length}</span></h3>
            <ul class="cred-list">
              {g.items.map((b) => (
                <li class="cred">
                  {b.local
                    ? <span class="cred-img cred-img-empty" aria-hidden="true"></span>
                    : <img class="cred-img" src={withBase(`badges/${b.id}.webp`)} alt="" width="56" height="56" loading="lazy" decoding="async" />}
                  <div>
                    {b.url ? <a class="cred-name" href={b.url}>{b.name}</a> : <span class="cred-name">{b.name}</span>}
                    <p class="cred-dates small muted num">
                      Issued {formatMonth(b.issuedOn.slice(0, 7))}{b.expiresOn && `, valid until ${formatMonth(b.expiresOn.slice(0, 7))}`}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- 4 Publications -->
    <section class="section" id="publications" aria-labelledby="h-publications">
      <div class="section-head">
        <span class="section-num">4</span>
        <h2 id="h-publications">Publications</h2>
      </div>
      <div class="section-body pubs">
        {publications.map((p) => (
          <article class="pub" id={`pub-${p.id}`}>
            <p class="pub-type">{p.type}<span class="muted num">{formatMonth(p.date)}</span></p>
            <h3>{p.url ? <a href={p.url}>{p.title}</a> : p.title}</h3>
            <p class="muted small">{p.publisher}{p.confidential && ', confidential'}</p>
            <p>{p.summary}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- 5 Projects -->
    <section class="section" id="projects" aria-labelledby="h-projects">
      <div class="section-head">
        <span class="section-num">5</span>
        <h2 id="h-projects">Side projects</h2>
        <p class="section-intro">Code I can share publicly.</p>
      </div>
      <div class="section-body table-scroll">
        <table class="spec">
          <thead><tr><th scope="col">Project</th><th scope="col">What it does</th><th scope="col">Built with</th></tr></thead>
          <tbody>
            {projects.map((p) => (
              <tr><th scope="row"><a href={p.url}>{p.title}</a></th><td>{p.summary}</td><td>{p.stack.join(', ')}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 6 Skills -->
    <section class="section" id="skills" aria-labelledby="h-skills">
      <div class="section-head">
        <span class="section-num">6</span>
        <h2 id="h-skills">Skills</h2>
      </div>
      <dl class="section-body skills">
        {skills.map((g) => (
          <div class="skill-row"><dt>{g.group}</dt><dd>{g.items.join(', ')}</dd></div>
        ))}
        <div class="skill-row"><dt>Languages</dt><dd>{profile.languages.map((l) => `${l.name}, ${l.level}`).join('; ')}</dd></div>
        <div class="skill-row"><dt>Education</dt><dd>{profile.education.map((e) => `${e.degree}, ${e.school}, ${e.start}–${e.end}`).join('; ')}</dd></div>
      </dl>
    </section>

    <!-- 7 Recognition -->
    <section class="section" id="recognition" aria-labelledby="h-recognition">
      <div class="section-head">
        <span class="section-num">7</span>
        <h2 id="h-recognition">Recognition and teaching</h2>
      </div>
      <div class="section-body recog">
        <div>
          <h3>Recognition</h3>
          <ul class="plain">{recognition.awards.map((a) => <li><strong>{a.title}</strong> <span class="muted num">{a.date}</span><br />{a.note}</li>)}</ul>
        </div>
        <div>
          <h3>Teaching and community</h3>
          <ul class="plain">{[...recognition.teaching, ...recognition.community].map((t) => <li><strong>{t.title}</strong> <span class="muted num">{t.period}</span><br />{t.note}</li>)}</ul>
        </div>
      </div>
    </section>

    <!-- 8 Contact -->
    <section class="section" id="contact" aria-labelledby="h-contact">
      <div class="section-head">
        <span class="section-num">8</span>
        <h2 id="h-contact">Contact</h2>
        <p class="section-intro">For projects, talks or questions AskMe could not answer.</p>
      </div>
      <div class="section-body contact">
        <ContactForm />
        <ul class="contact-links plain">
          <li><span class="muted small">Email</span><a href={`mailto:${profile.links.email}`}>{profile.links.email}</a></li>
          <li><span class="muted small">LinkedIn</span><a href={profile.links.linkedin}>vittorio-loris-simonetti</a></li>
          <li><span class="muted small">Credly</span><a href={profile.links.credly}>{credlyCount} badges</a></li>
          <li><span class="muted small">SAP Community</span><a href={profile.links.sapCommunity}>Profile</a></li>
          <li><span class="muted small">GitHub</span><a href={profile.links.github}>vittoriols</a></li>
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 3rem;
    grid-template-areas: 'intro ask' 'specs ask' '. ask';
    grid-template-rows: auto auto 1fr;
    align-items: start; padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }
  .hero-intro { grid-area: intro; }
  .hero-specs { grid-area: specs; }
  .hero-ask { grid-area: ask; }
  .name {
    font-size: clamp(3rem, 8.4vw, 6.4rem); line-height: 0.92; font-weight: 820;
    font-variation-settings: 'wdth' 122; letter-spacing: -0.03em; margin-bottom: 1.5rem;
  }
  .hero-role { font-weight: 600; font-size: var(--step-0); margin-bottom: 0.6rem; }
  .thesis { font-size: clamp(1.25rem, 2.1vw, 1.55rem); line-height: 1.35; max-width: 34rem; margin-bottom: 2rem; color: var(--ink); }
  .key-specs { max-width: 40rem; font-size: 0.95rem; }
  .key-specs th { width: 8.5rem; font-variation-settings: 'wdth' 85; color: var(--ink-2); font-weight: 560; }
  .hero-ask { position: sticky; top: 5rem; }
  @media (max-width: 960px) {
    .hero { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'intro' 'ask' 'specs'; grid-template-rows: none; row-gap: 2rem; }
    .hero-ask { position: static; }
    .thesis { margin-bottom: 0; }
  }
  @media (max-width: 560px) {
    .key-specs th { width: 6.5rem; }
    .key-specs th, .key-specs td { padding: 0.55rem 0.6rem; }
  }

  .about { margin-bottom: 2.5rem; }
  .roles { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .role {
    display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 1.5rem;
    padding: 1.4rem 0; border-bottom: 1px solid var(--rule);
  }
  .role:target { background: var(--signal-wash); box-shadow: -0.75rem 0 0 var(--signal-wash), 0.75rem 0 0 var(--signal-wash); }
  .role-period { margin: 0.2rem 0 0; font-size: var(--step--1); color: var(--ink-2); }
  .tag-live { display: block; color: var(--signal); font-weight: 650; margin-top: 0.25rem; }
  .role h3 { margin-bottom: 0.15rem; }
  .role-company { font-size: var(--step--1); margin-bottom: 0.6rem; }
  .role-highlights { margin: 0; padding-left: 1.1rem; color: var(--ink-2); font-size: 0.95rem; }
  @media (max-width: 640px) { .role { grid-template-columns: minmax(0, 1fr); gap: 0.25rem; } }

  .nowrap { white-space: nowrap; }

  .creds { display: grid; gap: 2rem; }
  .cred-issuer { font-size: var(--step-0); border-bottom: 1px solid var(--ink); padding-bottom: 0.4rem; margin-bottom: 0.25rem; }
  .cred-issuer .muted { font-weight: 400; margin-left: 0.35rem; }
  .cred-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr)); }
  .cred { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 0.9rem; align-items: center; padding: 0.75rem 0; border-bottom: 1px solid var(--rule-2); }
  .cred-img { width: 56px; height: 56px; object-fit: contain; }
  .cred-img-empty { border: 1px dashed var(--rule); border-radius: 50%; }
  .cred-name { font-weight: 600; line-height: 1.3; color: var(--ink); text-decoration: none; }
  a.cred-name:hover { color: var(--signal); text-decoration: underline; }
  .cred-dates { margin: 0.15rem 0 0; }

  .pubs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--rule); }
  .pub { padding: 1.25rem 1.5rem 1.25rem 0; }
  .pub + .pub { padding-left: 1.5rem; border-left: 1px solid var(--rule); }
  .pub:target { background: var(--signal-wash); }
  .pub-type { font-weight: 650; color: var(--signal); font-size: var(--step--1); display: flex; justify-content: space-between; gap: 1rem; }
  .pub h3 { margin-bottom: 0.4rem; }
  .pub h3 a { color: var(--ink); }
  .pub h3 a:hover { color: var(--signal); }
  @media (max-width: 860px) {
    .pubs { grid-template-columns: minmax(0, 1fr); }
    .pub, .pub + .pub { padding: 1.25rem 0; border-left: 0; border-bottom: 1px solid var(--rule); }
  }

  .skills { margin: 0; border-top: 1px solid var(--rule); }
  .skill-row { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 1.5rem; padding: 0.85rem 0; border-bottom: 1px solid var(--rule); }
  .skill-row dt { font-weight: 650; }
  .skill-row dd { margin: 0; color: var(--ink-2); }
  @media (max-width: 640px) { .skill-row { grid-template-columns: minmax(0, 1fr); gap: 0.2rem; } }

  .recog { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem; }
  .recog h3 { margin-bottom: 0.75rem; }
  .plain { list-style: none; margin: 0; padding: 0; }
  .recog li { padding: 0.75rem 0; border-top: 1px solid var(--rule-2); font-size: 0.97rem; }
  @media (max-width: 760px) { .recog { grid-template-columns: minmax(0, 1fr); } }

  .contact { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 3rem; align-items: start; }
  .contact-links li { display: grid; padding: 0.7rem 0; border-top: 1px solid var(--rule-2); }
  .contact-links li:first-child { border-top: 0; padding-top: 0; }
  @media (max-width: 760px) { .contact { grid-template-columns: minmax(0, 1fr); } }
</style>
